# MySQL connection string used by Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dental_atelier"

# Generate a strong random secret before deploying
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only when running the initial database seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
